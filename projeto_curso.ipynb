   "source": [
    "Funções:\n",
    "-> .head(): Seleciona as cinco primeiras linhas\n",
    "-> .tail(): Seleciona as cinco últimas linhas\n",
    "\n",
    "Propriedades:\n",
    "-> .columns: Retorna os nomes das colunas\n",
    "-> .dtypes: Retorna uma série com os tipos de dados de cada coluna"
